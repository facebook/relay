//- schema.graphql
type Query {
   node: Node
}

interface Node {
   id: ID!
}

interface Actor {
   name: String
}

type User implements Node & Actor {
   id: ID!
   name: String
   username: String
}

type Page implements Node {
   id: ID!
}
