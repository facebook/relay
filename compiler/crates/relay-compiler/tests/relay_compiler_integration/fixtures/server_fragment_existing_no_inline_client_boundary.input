//- src/Fragments.js

graphql`fragment ServerParent_user on User @server {
  ...ClientCard_user @alias(as: "clientCard")
}`

graphql`fragment ClientCard_user on User @no_inline {
  name
}`

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "featureFlags": {
        "enable_relay_rsc": true,
        "no_inline": {"kind": "enabled"}
      }
    }
  }
}

//- schema.graphql
type Query {
  me: User
}

type User {
  name: String
}
