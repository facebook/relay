//- schema.graphql
type Query {
  page: Page
  node(id: ID!): Node
}

interface Node {
  id: ID!
}

type Page implements Node {
  id: ID!
  title: String
  stats: PageStats
}

type PageStats {
  views: Int
}

//- schema-extensions/extension.graphql
extend type Page {
  unused_client_field: String
}
