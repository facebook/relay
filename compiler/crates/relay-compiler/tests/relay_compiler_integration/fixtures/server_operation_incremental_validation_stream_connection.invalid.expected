//- src/ServerStreamConnection.js

// `@stream_connection` is found as authored, without relying on
// `transform_connections` to expand it into `@stream` on `edges` and
// `@defer` on `pageInfo` first.
graphql`query ServerStreamConnectionQuery @server {
  me {
    friends(first: 1)
      @stream_connection(
        key: "ServerStreamConnectionQuery_friends"
        initial_count: 1
      ) {
      edges {
        node {
          name
        }
      }
    }
  }
}`

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "featureFlags": {
        "enable_relay_rsc": true
