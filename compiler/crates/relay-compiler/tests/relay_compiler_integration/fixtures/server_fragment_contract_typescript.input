//- src/ServerFragments.ts

graphql`fragment ServerParent_user on User @server {
  name
  ...ServerChild_user
}`

graphql`fragment ServerChild_user on User @server {
  id
}`

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "typescript",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    }
  }
}

//- schema.graphql
type Query {
  me: User
}

type User {
  id: ID!
  name: String
}
