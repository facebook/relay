==================================== INPUT ====================================
# When ALL concrete type branches in a raw response union implement the
# abstract type, the fallback should also have the interface fields as
# non-optional since every known type has them.
# Here, Node is the interface and all concrete branches (FakeNode from
# generate_id_field, plus any others) implement it, so id should be
# non-optional in the fallback.
query ExampleQuery @raw_response_type {
  node(id: "1") {
    __typename
    ... on FeedUnit {
      id
    }
  }
}
==================================== OUTPUT ===================================
export type ExampleQuery$variables = {};
export type ExampleQuery$data = {
  readonly node: ?({
    // This will never be '%other', but we need some
    // value in case none of the concrete values match.
    readonly __typename: "%other",
  } | {
    readonly __typename: "PhotoStory" | "Story",
    readonly id: string,
  }),
};
export type ExampleQuery$rawResponse = {
  readonly node: ?{
    readonly __typename: string,
    readonly __isFeedUnit?: string,
    readonly id: string,
  },
};
export type ExampleQuery = {
  rawResponse: ExampleQuery$rawResponse,
  response: ExampleQuery$data,
  variables: ExampleQuery$variables,
};
