// Synthetic refetch roots can opt into exec time independently of the
// feature switch, so their shared client edges need full caller context.

//- Refetch.js
graphql`fragment Refetch_user on User
@refetchable(queryName: "RefetchQuery", directives: ["@exec_time_resolvers"]) {
  ...Shared_user
}`

//- ReadQuery.js
graphql`query ReadQuery {
  me {
    ...Shared_user
  }
}`

//- Shared.js
graphql`fragment Shared_user on User {
  best_friend @waterfall {
    name
  }
}`

//- User_best_friend.js
/**
 * @relayField User.best_friend: User
 */

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "featureFlags": {
    "enable_exec_time_resolvers_directive": false
  }
}

//- schema.graphql
type Query { me: User, node(id: ID!): Node }
interface Node { id: ID! }
type User implements Node { id: ID!, name: String }

//-++ ReadQuery.js
graphql`query ReadQuery {
  me {
    id
    ...Shared_user
  }
}`
