}

//- schema.graphql
directive @stream(
  label: String!
  initialCount: Int!
  if: Boolean = true
  useCustomizedBatch: Boolean = false
) on FIELD

directive @defer(
  label: String!
  if: Boolean = true
) on FRAGMENT_SPREAD | INLINE_FRAGMENT

type Query {
  me: User
}

type User {
  name: String
  friends(first: Int, after: ID): FriendsConnection
}

type FriendsConnection {
  edges: [FriendsEdge]
  pageInfo: PageInfo
}

type FriendsEdge {
  cursor: ID
  node: User
}

type PageInfo {
  startCursor: ID
  endCursor: ID
  hasNextPage: Boolean
  hasPreviousPage: Boolean
}
