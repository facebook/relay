//- base_src/RscPanel.js

/**
 * @relayField User.rscPanel: RelayRscValue
 * @rootFragment RscPanel_user
 */
graphql`fragment RscPanel_user on User @server {
  name
}`

export function RscPanel() {}

//- base_src/BasePage.js

graphql`query BasePageQuery @server {
  me {
    panel: rscPanel
  }
}`

//- derived_src/DerivedPage.js

// The RSC Resolver's root fragment comes from the base project, which writes
// `RscPanel_user$normalization`. The derived project imports that artifact
// and does not write a second copy, like a client-component boundary over a
// base fragment.
graphql`query DerivedPageQuery @server {
  me {
    panel: rscPanel
  }
}`

//- relay.config.json
{
  "sources": {
    "base_src": "base_project",
    "derived_src": "derived_project"
  },
  "projects": {
    "base_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "jsModuleFormat": "commonjs",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    },
    "derived_project": {
      "schema": "schema.graphql",
      "base": "base_project",
      "language": "javascript",
      "jsModuleFormat": "commonjs",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    }
  }
}

//- schema.graphql
type Query {
  me: User
}

type User {
  id: ID!
  name: String
}
