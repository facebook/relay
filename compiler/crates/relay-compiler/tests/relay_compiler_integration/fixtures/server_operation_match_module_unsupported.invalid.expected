//- src/ServerMatch.js

// `@match` on a field and `@module` on a spread inside a server query are
// outside the server-owned selection directive allowlist.
graphql`query ServerMatchQuery @server {
  me {
    nameRenderer @match {
      ...ServerMatch_plainRenderer @module(name: "PlainRenderer.react")
    }
  }
}`

graphql`fragment ServerMatch_plainRenderer on PlainUserNameRenderer @server {
  plaintext
}`

