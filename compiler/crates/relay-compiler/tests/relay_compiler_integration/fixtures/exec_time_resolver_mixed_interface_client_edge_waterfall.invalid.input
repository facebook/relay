// Test: `@waterfall` is rejected on a client edge to a mixed interface under
// UNCONDITIONAL @exec_time_resolvers, because the executor has no refetch path
// to opt into. `IVehicle` is mixed: the server type `Bicycle` and the client
// model `Car`.
//
// The directive must stay bare. With `enabledProvider` the document is also
// read-time-capable, `@waterfall` becomes required rather than rejected, and the
// refetch operation is generated -- see
// `exec_time_resolver_mixed_interface_client_edge_enabled_provider`.
//- PersonComponent.js
graphql`query PersonComponentQuery @exec_time_resolvers {
  vehicle @waterfall {
    id
  }
}`

//- VehicleResolver.js
/**
 * @relayField Query.vehicle: IVehicle
 */
export function vehicle() {}

//- CarResolver.js
/**
 * @relayType Car implements IVehicle
 */
export function Car() {}

//- CarWheelsResolver.js
/**
 * @relayField Car.wheels: Int
 */
export function wheels() {}

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "schemaExtensions": [
    "schema-extensions"
  ],
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true,
    "relay_resolver_enable_interface_output_type": { "kind": "enabled" }
  }
}

//- schema.graphql
type Query {
  node(id: ID!): Node
}

interface Node {
  id: ID!
}

type Bicycle implements Node {
  id: ID!
  wheels: Int
}

//- schema-extensions/extension.graphql
interface IVehicle {
  id: ID!
}

extend type Bicycle implements IVehicle
