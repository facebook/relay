//- schema.graphql
type Query {
  me: User
}

type User {
  name: String
  friends(first: Int, after: ID): FriendsConnection
}

type FriendsConnection {
  edges: [FriendsEdge]
  pageInfo: PageInfo
}

type FriendsEdge {
  cursor: ID
  node: User
}

type PageInfo {
  startCursor: ID
  endCursor: ID
  hasNextPage: Boolean
  hasPreviousPage: Boolean
}
