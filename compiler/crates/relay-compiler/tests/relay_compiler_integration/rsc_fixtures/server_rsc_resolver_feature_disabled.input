//- src/Page.js

graphql`query ServerRscResolverFeatureDisabledQuery @server {
  me {
    panel: rscPanel
  }
}`

//- src/RscPanel.js

/**
 * @relayField User.rscPanel: RelayRscValue
 * @rootFragment RscPanel_user
 */
graphql`fragment RscPanel_user on User @server {
  name
}`

export function RscPanel() {}

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "jsModuleFormat": "commonjs"
    }
  }
}

//- schema.graphql
type Query {
  me: User
}

type User {
  id: ID!
  name: String
}
