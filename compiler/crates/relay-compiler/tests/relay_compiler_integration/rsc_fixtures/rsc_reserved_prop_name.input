//- src/Page.js

// React strips `key`, so it cannot carry the root fragment.
graphql`query RscReservedPropNameQuery @server {
  me {
    rscPanel
  }
}`

//- src/RscPanel.js

/**
 * @relayField User.rscPanel: RelayRscValue
 * @rootFragment RscPanel_key
 */
graphql`fragment RscPanel_key on User @server {
  name
}`

export function RscPanel() {}

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "jsModuleFormat": "commonjs",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    }
  }
}

//- schema.graphql
type Query {
  me: User
}

type User {
  id: ID!
  name: String
}
