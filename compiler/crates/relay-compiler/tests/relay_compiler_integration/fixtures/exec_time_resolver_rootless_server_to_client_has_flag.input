// Test: an exec-time S2C resolver with NO `@rootFragment` gets
// `runsOnServerRecord` on its `resolverInfo`, which is what the normalizer
// collects it by, and its operation gets `has_server_to_client_resolvers`, which
// routes it to the path where S2C resolvers run. `BarQuery` is the control: a
// rootless resolver on `Query` is built with the query root, so it gets neither.

//- FooQuery.js
graphql`query FooQuery($text: String!) @exec_time_resolvers {
  me {
    echo(text: $text)
  }
}`

//- BarQuery.js
graphql`query BarQuery($text: String!) @exec_time_resolvers {
  root_echo(text: $text)
}`

//- User_echo.js
/**
 * @relayField User.echo(text: String!): RelayResolverValue
 */

//- Query_root_echo.js
/**
 * @relayField Query.root_echo(text: String!): RelayResolverValue
 */

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true
  }
}

//- schema.graphql
type Query { me: User }
type User { id: ID!, name: String }
