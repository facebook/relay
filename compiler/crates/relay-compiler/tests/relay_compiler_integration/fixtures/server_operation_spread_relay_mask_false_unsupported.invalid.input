//- src/ServerUnmasked.js

// `@relay(mask: false)` on a client fragment spread would inline the client
// fragment's selections into the server query without an aliased
// client-component boundary.
graphql`query ServerUnmaskedQuery @server {
  me {
    ...ServerUnmasked_user @relay(mask: false)
  }
}`

graphql`fragment ServerUnmasked_user on User {
  name
}`

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    }
  }
}

//- schema.graphql
type Query {
  me: User
}

type User {
  id: ID!
  name: String
}
