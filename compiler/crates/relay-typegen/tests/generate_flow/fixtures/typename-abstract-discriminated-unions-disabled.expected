query ConditionalLinkedFieldMerge($condition: Boolean!) {
  node(id: "4") {
    __typename
    ... on VideoLike {
      ... on User {
        address @include(if: $condition) {
          street
        }
      }
    }
    ... on Named {
      ... on User {
        address {
          country
        }
      }
    }
  }
}

fragment AbstractTypenameAliasGrouping on Actor {
  __typename
  ... on VideoLike {
    kind: __typename
  }
}

fragment AbstractUnionNamedFragment on Named {
  name
}

%extensions%

interface VideoLike {
  canPlay: Boolean
}

extend type User implements VideoLike {
  canPlay: Boolean
}

extend type Page implements VideoLike {
  canPlay: Boolean
}

type AbstractUnionActorOnly implements Actor {
  id: ID!
}
