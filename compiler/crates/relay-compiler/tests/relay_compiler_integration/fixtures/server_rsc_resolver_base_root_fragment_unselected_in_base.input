//- base_src/RscPanel.js

/**
 * @relayField User.rscPanel: RelayRscValue
 * @rootFragment RscPanel_user
 */
graphql`fragment RscPanel_user on User @server {
  name
}`

export function RscPanel() {}

//- derived_src/DerivedPage.js

// No base document selects the RSC Resolver field. The base project still
// writes its root fragment's `RscPanel_user$normalization`, which the derived
// project imports.
graphql`query DerivedPageQuery @server {
  me {
    panel: rscPanel
  }
}`

//- relay.config.json
{
  "sources": {
    "base_src": "base_project",
    "derived_src": "derived_project"
  },
  "projects": {
    "base_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "jsModuleFormat": "commonjs",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    },
    "derived_project": {
      "schema": "schema.graphql",
      "base": "base_project",
      "language": "javascript",
      "jsModuleFormat": "commonjs",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    }
  }
}

//- schema.graphql
type Query {
  me: User
}

type User {
  id: ID!
  name: String
}
