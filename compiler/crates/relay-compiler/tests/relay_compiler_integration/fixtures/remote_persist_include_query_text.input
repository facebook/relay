// `includeQueryText: true` keeps `text` non-null in the artifact params after persisting (default is null).

//- component.js
graphql`query RemotePersistIncludeQueryTextQuery { greeting }`

//- relay.config.json
{
   "language": "flow",
   "schema": "./schema.graphql",
   "src": "./",
   "persistConfig": {
      "url": "relay-test://persist",
      "includeQueryText": true
   }
}

//- schema.graphql
type Query { greeting: String }
