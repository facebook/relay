// Consumers below type `id` as `?string`. That is NOT this change: whether
// typegen widens a semantically non-null field to non-null is governed by
// semantic-nullability typegen, configured separately. What this fixture pins
// is that the interface COMPILES and both arms produce artifacts.
//- PetComponent.js
graphql`fragment PetComponentFragment on IPet {
  id
  name
}`

//- CatResolvers.js
/**
 * @relayType Cat
 */

/**
 * @relayField Cat.name: String
 */

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "schemaExtensions": [
    "schema-extensions"
  ],
  "featureFlags": {
    "enable_resolver_normalization_ast": true,
    "relay_resolver_enable_interface_output_type": { "kind": "enabled" }
  }
}

//- schema.graphql
type Query {
  greeting: String
  dog: Dog
}

# A SERVER type whose `id` is semantically rather than structurally non-null —
# the shape `AdAccount` has, and the reason its interface cannot declare `ID!`.
type Dog {
  id: ID @semanticNonNull
  name: String
}

//- schema-extensions/extension.graphql
# Implemented by BOTH a strong client model (`Cat`) and a server type (`Dog`).
# The strong model is what makes Relay require a non-null `id` here; declaring
# it `ID!` would make `Dog` unable to implement the interface.
interface IPet {
  id: ID @semanticNonNull
  name: String
}

extend type Cat implements IPet

extend type Dog implements IPet
