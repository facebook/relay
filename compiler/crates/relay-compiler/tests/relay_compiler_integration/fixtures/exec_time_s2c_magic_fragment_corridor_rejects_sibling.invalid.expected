==================================== INPUT ====================================
// Test: the magic fragment corridor does NOT launder a sibling.
//
// A magic fragment's shadowed field can sit several server links below the root
// fragment, so those ancestors are walked through instead of rejected. The risk
// is treating an ancestor as a blanket exemption, which would let an unrelated
// field ride along beside the shadowed one:
//
//     viewer {
//       unsupported_field                     # nothing fetches this
//       page { ...ReturnFragment }            # the transplant fetches this
//     }
//
// Only the transplant's own path is in the payload. `unsupported_field` is not,
// and at exec time it would read back as undefined with no error — the same
// silent failure the identity-only rule exists to prevent.
//
// So every sibling is checked on its own merits. `viewer` and `page` are
// permitted, `unsupported_field` is not. The positive control, identical but for
// the sibling, is `exec_time_s2c_magic_fragment_corridor_allows_nested_path`.
//- QueryShadowCorridor.js
/**
 * @relayField Query.shadow_page: IPage
 * @rootFragment QueryShadowCorridorResolverFragment
 * @returnFragment QueryShadowCorridorReturnFragment
 */
graphql`fragment QueryShadowCorridorResolverFragment on Query {
  viewer {
    unsupported_field
    page {
      ...QueryShadowCorridorReturnFragment
    }
  }
}`

//- Consumer.js
graphql`query ConsumerQuery @exec_time_resolvers {
  shadow_page {
    title
  }
}`

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "schemaExtensions": ["schema-extensions"],
  "featureFlags": {
    "enable_shadow_resolvers": {"kind": "enabled"},
    "enable_exec_time_resolvers_directive": true,
    "relay_resolver_enable_interface_output_type": {"kind": "enabled"}
  }
}

//- schema.graphql
type Query {
  viewer: Viewer
  node(id: ID!): Node
}

interface Node {
  id: ID!
}

type Viewer {
  unsupported_field: String
  page: Page
}

type Page implements Node {
  id: ID!
  title: String
}

//- schema-extensions/extension.graphql
interface IPage implements Node {
  id: ID!
  title: String
}

extend type Page implements IPage
