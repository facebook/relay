//- src/ServerDeferred.js

// `relayRsc.allowIncrementalDelivery` is explicitly true. Server-owned
// operations still cannot use `@defer`, and the error must not blame the
// capability.
graphql`query ServerDeferredQuery @server {
  me {
    ...ServerDeferred_user @defer(label: "ServerDeferredQuery$user")
  }
}`

graphql`fragment ServerDeferred_user on User @server {
  name
}`

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "relayRsc": {
        "allowIncrementalDelivery": true
      },
      "featureFlags": {
        "enable_relay_rsc": true
      }
    }
  }
}

//- schema.graphql
directive @defer(
  label: String!
  if: Boolean = true
) on FRAGMENT_SPREAD | INLINE_FRAGMENT

type Query {
  me: User
}

type User {
  name: String
}
