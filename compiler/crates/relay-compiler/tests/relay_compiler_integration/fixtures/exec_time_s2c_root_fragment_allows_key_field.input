// Test: `@UNSTABLE_key` is the escape hatch from the exec-time S2C identity-only rule.
//
// `User.actor_key` is a server field, so without the annotation it is rejected —
// exec time projects the root fragment from a record holding only identity and
// would read it back as undefined. `extend type User @UNSTABLE_key(fields: "actor_key")`
// is the schema owner asserting that the field is stable for the record's
// lifetime and always arrives in the same payload, which is what makes it safe
// to project.
//
// The negative control is `exec_time_s2c_root_fragment_rejects_unkeyed_field.invalid`:
// the same query and the same annotation, reading a DIFFERENT field, which must
// still be rejected. `@UNSTABLE_key` grants exactly the fields it names.
//- FooQuery.js
graphql`query FooQuery @exec_time_resolvers {
  me {
    greeting
  }
}`

//- User_greeting.js
/**
 * @relayField User.greeting: RelayResolverValue
 * @rootFragment UserGreetingFragment
 */
graphql`fragment UserGreetingFragment on User {
  id
  actor_key
}`

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "schemaExtensions": ["schema-extensions"],
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true
  }
}

//- schema.graphql
type Query {
  me: User
}

type User {
  id: ID!
  name: String
  actor_key: ID!
}

//- schema-extensions/extension.graphql
extend type User @UNSTABLE_key(fields: "actor_key")
