// Test: `enabledProvider` makes exec-vs-read time a RUNTIME decision, so this
// document can still run at read time and its client edge to the mixed interface
// `IVehicle` keeps the per-implementor `ClientEdgeQuery`. `@waterfall` is
// required, not rejected: read time performs the refetch, and suppressing the
// operation at compile time would leave read time unable to resolve the server
// arm. Contrast the bare-directive
// `exec_time_resolver_mixed_interface_client_edge_waterfall.invalid`.
//- PersonComponent.js
graphql`query PersonComponentQuery @exec_time_resolvers(enabledProvider: "execTimeResolversFlagProvider") {
  vehicle @waterfall {
    id
  }
}`

//- VehicleResolver.js
/**
 * @relayField Query.vehicle: IVehicle
 */
export function vehicle() {}

//- CarResolver.js
/**
 * @relayType Car implements IVehicle
 */
export function Car() {}

//- CarWheelsResolver.js
/**
 * @relayField Car.wheels: Int
 */
export function wheels() {}

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "schemaExtensions": [
    "schema-extensions"
  ],
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true,
    "relay_resolver_enable_interface_output_type": { "kind": "enabled" }
  }
}

//- schema.graphql
type Query {
  node(id: ID!): Node
}

interface Node {
  id: ID!
}

type Bicycle implements Node {
  id: ID!
  wheels: Int
}

//- schema-extensions/extension.graphql
interface IVehicle {
  id: ID!
}

extend type Bicycle implements IVehicle
