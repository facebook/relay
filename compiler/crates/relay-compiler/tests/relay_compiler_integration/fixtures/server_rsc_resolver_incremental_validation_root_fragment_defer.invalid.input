//- src/Page.js

graphql`query ServerRscResolverDeferQuery @server {
  me {
    panel: rscPanel
  }
}`

//- src/RscPanel.js

/**
 * @relayField User.rscPanel: RelayRscValue
 * @rootFragment RscPanel_user
 */
// The `@defer` is reachable from the query only through the RSC Resolver's
// root fragment. The incremental delivery validation follows Resolver root
// fragments itself, so it does not depend on `lower_rsc_resolver_fields`.
graphql`fragment RscPanel_user on User @server {
  ...DeferredName_user @defer(label: "RscPanel_user$name")
}`

graphql`fragment DeferredName_user on User @server {
  name
}`

export function RscPanel() {}

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "jsModuleFormat": "commonjs",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    }
  }
}

//- schema.graphql
directive @defer(
  label: String!
  if: Boolean = true
) on FRAGMENT_SPREAD | INLINE_FRAGMENT

type Query {
  me: User
}

type User {
  id: ID!
  name: String
}
