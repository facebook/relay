//- foo.js
graphql`query fooQuery {
  greeting
}`

//- relay.config.json
{
  "language": "flow",
  "schema": "./schema.graphql",
  "featureFlags": {
    "disable_schema_validation": {
      "kind": "limited",
      "allowlist": ["Query.farewell"]
    }
  }
}

//- schema.graphql
# `Query` has no `farewell` field, so that allowlist entry is reported at the type.
type Query {
  greeting: String
}
