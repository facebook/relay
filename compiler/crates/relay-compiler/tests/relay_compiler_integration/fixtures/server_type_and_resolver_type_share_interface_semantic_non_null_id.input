// The fragment never selects `id`. Relay injects `id` when normalizing the
// abstract `IAdAccount` selection, and that injected field is compared across
// the concrete types. `relay_resolver_model_semantic_non_null_id` generates
// `ClientAdAccount.id` as `ID @semanticNonNull`, matching `AdAccount.id`.
//- AdAccountQuery.js
graphql`query AdAccountQuery {
  ad_account {
    ...AdAccountCurrencyFragment
  }
}`

//- AdAccountCurrencyFragment.js
graphql`fragment AdAccountCurrencyFragment on IAdAccount {
  currency
}`

//- ClientAdAccountResolvers.js
/**
 * @relayType ClientAdAccount implements IAdAccount
 */

/**
 * @relayField ClientAdAccount.currency: String
 */

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "schemaExtensions": [
    "schema-extensions"
  ],
  "featureFlags": {
    "enable_resolver_normalization_ast": true,
    "relay_resolver_enable_interface_output_type": { "kind": "enabled" },
    "relay_resolver_model_semantic_non_null_id": {
      "kind": "limited",
      "allowlist": ["ClientAdAccount"]
    }
  }
}

//- schema.graphql
type Query {
  ad_account: AdAccount
}

type AdAccount {
  id: ID @semanticNonNull
  currency: String
}

//- schema-extensions/extension.graphql
interface IAdAccount {
  id: ID @semanticNonNull
  currency: String
}

extend type AdAccount implements IAdAccount
