// Test: `@UNSTABLE_key` cannot grant a field that TAKES ARGUMENTS.
//
// The grant asserts a field is stable for the record's lifetime and always
// arrives in the same payload as the record. Neither can hold for a field whose
// value depends on its arguments: two selections with different arguments are
// different values under one name, and the field set names only the name.
//
// The positive control is `exec_time_s2c_root_fragment_allows_key_field`, whose
// granted field takes none.
//- FooQuery.js
graphql`query FooQuery @exec_time_resolvers {
  me {
    greeting
  }
}`

//- User_greeting.js
/**
 * @relayField User.greeting: RelayResolverValue
 * @rootFragment UserGreetingFragment
 */
graphql`fragment UserGreetingFragment on User {
  id
  nickname(length: 3)
}`

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "schemaExtensions": ["schema-extensions"],
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true
  }
}

//- schema.graphql
type Query {
  me: User
}

type User {
  id: ID!
  name: String
  nickname(length: Int): String
}

//- schema-extensions/extension.graphql
extend type User @UNSTABLE_key(fields: "nickname")
